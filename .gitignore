# Rust
/target
# local, host-specific cargo settings (e.g. build jobs); never required by public commands
/.cargo/config.toml
# local developer environment for scripts/env.sh (data root etc.)
/scripts/env.local.sh
Cargo.lock.orig

# Large/generated/private material lives under the data root $KOKORO_DATA, outside Git (docs/PORTABILITY.md)
*.wav
*.flac
*.mp3
*.npy
*.npz
*.pt
*.pth
*.safetensors
*.onnx
__pycache__/
*.pyc
.venv/
venv/

# Evidence bundles are hashed + summarized in-repo; raw payloads stay under $KOKORO_DATA
/evidence-raw/

# Editor/OS noise
.DS_Store
*.swp

# Private/copyrighted benchmark fixtures and any text-bearing derivatives never enter Git
bench/private/
**/private/
